# Azure AI Vision (Image Analysis 4.0)
AZURE_AI_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_AI_VISION_KEY=your-key-here

# Azure OpenAI (GPT-4o multimodal)
# AZURE_OPENAI_ENDPOINT accepts either form:
#   https://<your-resource>.openai.azure.com/                              (base URL, preferred)
#   https://<your-resource>.openai.azure.com/openai/deployments/<deploy>   (full deployment URL)
# The app normalizes either form via app/_azure_endpoint.py.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-key-here

# Optional: Custom Vision (backward compatibility only, retiring Sept 2028)
# CUSTOM_VISION_ENDPOINT=https://your-customvision-endpoint.cognitiveservices.azure.com/
# CUSTOM_VISION_KEY=your-custom-vision-key-here
# CUSTOM_VISION_PROJECT_ID=your-project-id-here
# CUSTOM_VISION_ITERATION_NAME=production
